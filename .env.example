# Public HTTPS origin, without a trailing slash or path
BASE_URL=https://music.example.com
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me
# Reverse proxy at 10.6.9.4 must be able to reach this host and port
BIND_ADDRESS=0.0.0.0
PORT=8090
